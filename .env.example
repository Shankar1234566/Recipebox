# ==============================================================================
# RecipeBox Environment Configuration & Setup Template (Render & Local)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#      cp .env.example .env
# 2. For Render Deployment:
#      Add these keys in your Render Dashboard -> Service -> Environment Variables.
# 3. NEVER commit your '.env' file or expose 'RAZORPAY_KEY_SECRET' to frontend code.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network & Host Configuration
# ------------------------------------------------------------------------------
# Render automatically sets PORT (typically 10000). Defaults to 5000 locally.
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Production CORS (Frontend Origins)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example: https://recipebox.onrender.com,https://recipebox.vercel.app
FRONTEND_URL=https://your-frontend-domain.onrender.com

# ------------------------------------------------------------------------------
# Database Persistence Configuration
# ------------------------------------------------------------------------------
# IMPORTANT FOR RENDER:
# Render containers use an ephemeral filesystem by default.
# Option A (Recommended with SQLite):
#   Attach a Render Persistent Disk (e.g. Mount Path: /var/data, Size: 1GB)
#   and set: DATABASE_URL=/var/data/recipebox.db
# Option B (Local Development default):
#   DATABASE_URL=server/data/recipebox.db
DATABASE_URL=/var/data/recipebox.db

# ------------------------------------------------------------------------------
# Authentication Security (JWT Signing Secret)
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing 7-day session tokens
JWT_SECRET=your_super_secret_jwt_key_recipebox_2026

# Set to 'true' if you want the API to include 'dev_otp' in responses for testing
# Set to 'false' in live production
SHOW_DEMO_OTP=false

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode Credentials)
# ------------------------------------------------------------------------------
# Steps to obtain your Test Mode API Keys:
# 1. Log in to your Razorpay Dashboard: https://dashboard.razorpay.com
# 2. Switch the top toggle to 'Test Mode'.
# 3. Go to Settings -> API Keys -> Click 'Generate Key'.
# 4. Copy 'Key Id' and 'Key Secret' into the placeholders below:
RAZORPAY_KEY_ID=your_new_test_key_id
RAZORPAY_KEY_SECRET=your_new_test_key_secret

# Optional: Razorpay Webhook Secret
# Set if configuring webhooks in Razorpay Dashboard (Settings -> Webhooks)
# Webhook URL: https://your-backend-service.onrender.com/api/payments/webhook
# Supported Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# Optional Notification Services
# ------------------------------------------------------------------------------
# SMS Provider API Key (Optional: for transactional SMS delivery)
SMS_PROVIDER_API_KEY=your_sms_gateway_api_key_here

# SMTP Configuration (Optional: for live email OTP delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
